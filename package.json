{
  "name": "real-estate-listings-aggregator",
  "version": "1.0.0",
  "description": "MERN stack listings aggregation application",
  "private": true,
  "workspaces": [
    "client"
  ],
  "scripts": {
    "install-all": "npm install",
    "build": "npm run build -w client && dotnet build server-dotnet/ListingsApi.csproj",
    "dev": "concurrently -k \"npm run server\" \"npm run client\"",
    "start": "npm run server",
    "server": "dotnet run --project server-dotnet/ListingsApi.csproj",
    "client": "npm run dev -w client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
